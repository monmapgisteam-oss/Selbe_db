# ── Сэлбэ Telegram бот — 24/7 тохиргоо ────────────────────────────────────
# Энэ файлыг `.env` болгож ХУУЛААД утгуудаа бөглөнө. `.env` нь git-д ОРОХГҮЙ.

# BotFather-аас авсан ботын токен (ЗААВАЛ)
#   Telegram-д @BotFather → /newbot → нэр өгөөд токеныг хуулна.
TELEGRAM_BOT_TOKEN=

# Админ Telegram ID-ууд, таслалаар (ЗААВАЛ 1-ээс доошгүй).
#   123456789             → бүх өгөгдөлд хандана
#   123456789:plan|bagts  → зөвхөн тэр харагдацууд
# Өөрийн ID-г Telegram-д @userinfobot-д бичээд авна.
# ⚠️ Зөвхөн эдгээр хүн бусдыг зөвшөөрөх (эрх өгөх) эрхтэй.
TELEGRAM_ALLOWED=

# LLM реле — байршуулсан Cloudflare worker.
NEXT_PUBLIC_AGENT_API=https://selbe-agent.monmapgisteam.workers.dev

# Реле рүү ботыг батлах нууц. Worker дээрх `BOT_SECRET`-тэй ЯГ ИЖИЛ байх ёстой.
#   Санамсаргүй утга үүсгэх:   openssl rand -hex 32
#   Worker дээр тавих:         cd agent-proxy && npx wrangler secret put BOT_SECRET
AGENT_BOT_SECRET=

# ⚠️ Browser-гүй тул ArcGIS нэвтрэлт УНТРААЛТТАЙ — хоосон орхи.
#    (Docker дүрст мөн тавьсан; systemd-д энд заавал хоосон байлга.)
NEXT_PUBLIC_AUTH_APP_ID=
# ⚠️ 2026-09-25: appId хоосон үед `services.ts` нь ЭНЭ тугийг шаардана — эс бөгөөс бот асахгүй.
NEXT_PUBLIC_AUTH_OFF=1

# ── Үйлчилгээний хаягууд (ЗААВАЛ) ─────────────────────────────────────────
# ⚠️ 2026-09-25: код дотор fallback БАЙХГҮЙ — ботын цөм `src/lib/services.ts`-ийг
#    импортлох мөчид доорх бүгд байх ёстой, дутуу бол `req()` алдаа шидэж бот асахгүй.
#    Утгыг репогийн үндсэн `.env`-ээс ХУУЛНА (image-д тэр файл ордоггүй).
#    Нэрийн жагсаалт: репогийн үндсэн `.env.example`. ⚠️ 2026-10-19: `tools/envParity.check.mjs` энэ файлд
#    кодын `req()`/`svcRoot()`-оор шаардсан БҮХ хувьсагч байгаа эсэхийг шалгана.
# ⚠️ Бүх ArcGIS үйлчилгээ Organization-only — бот өгөгдөл уншихын тулд доорх
#    «ArcGIS-ийн уншилтын эрх» хэсгийг ЗААВАЛ бөглөнө (эс бөгөөс асуулт бүрд тодорхой алдаа).
NEXT_PUBLIC_PORTAL_URL=
NEXT_PUBLIC_ALLOWED_ORG_ID=
NEXT_PUBLIC_ENT_DATA=
NEXT_PUBLIC_HABEA_LABOR_SVC=
NEXT_PUBLIC_HABEA_INCIDENT_SVC=
NEXT_PUBLIC_HABEA_UZLEG_V11_SVC=
NEXT_PUBLIC_HABEA_UZLEG_G_SVC=

# ── ArcGIS-ийн уншилтын эрх (⚠️ 2026-10-22) ────────────────────────────────
# Бот Node-д ажилладаг тул хөтөчийн нэвтрэлтгүй — Enterprise порталын (NEXT_PUBLIC_PORTAL_URL)
# ЗӨВХӨН УНШИХ эрхтэй ТУСГАЙ аккаунтаар токен авна. Нэгийг сонгоно:
#   (1) Зөвлөмж — нэр + нууц үг: бот `generateToken`-оор (client=requestip) токен авч,
#       хугацаа дуусахаас өмнө өөрөө шинэчилнэ. Хоёулаа байвал энэ давамгайлна.
ARCGIS_BOT_USERNAME=
ARCGIS_BOT_PASSWORD=
#   Токены хугацаа, минут (5–20160; хоосон бол 120).
ARCGIS_BOT_TOKEN_MINUTES=
#   (2) Урьдчилан үүсгэсэн тогтмол токен — шинэчлэгдэхгүй, хугацаа дуусвал гараар солино.
ARCGIS_BOT_TOKEN=
# ⚠️ Нууцыг git-д, логт, чатад хэзээ ч бүү оруул — бот өөрөө ч логлодоггүй.
