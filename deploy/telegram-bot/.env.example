# ── Сэлбэ Telegram бот — 24/7 тохиргоо ────────────────────────────────────
# Энэ файлыг `.env` болгож ХУУЛААД утгуудаа бөглөнө. `.env` нь git-д ОРОХГҮЙ.

# BotFather-аас авсан ботын токен (ЗААВАЛ)
#   Telegram-д @BotFather → /newbot → нэр өгөөд токеныг хуулна.
TELEGRAM_BOT_TOKEN=

# Админ Telegram ID-ууд, таслалаар (ЗААВАЛ 1-ээс доошгүй).
#   123456789             → бүх өгөгдөлд хандана
#   123456789:plan|bagts  → зөвхөн тэр харагдацууд
# Өөрийн ID-г Telegram-д @userinfobot-д бичээд авна.
# ⚠️ Зөвхөн эдгээр хүн бусдыг зөвшөөрөх (эрх өгөх) эрхтэй.
TELEGRAM_ALLOWED=

# LLM реле — байршуулсан Cloudflare worker.
NEXT_PUBLIC_AGENT_API=https://selbe-agent.monmapgisteam.workers.dev

# Реле рүү ботыг батлах нууц. Worker дээрх `BOT_SECRET`-тэй ЯГ ИЖИЛ байх ёстой.
#   Санамсаргүй утга үүсгэх:   openssl rand -hex 32
#   Worker дээр тавих:         cd agent-proxy && npx wrangler secret put BOT_SECRET
AGENT_BOT_SECRET=

# ⚠️ Browser-гүй тул ArcGIS нэвтрэлт УНТРААЛТТАЙ — хоосон орхи.
#    (Docker дүрст мөн тавьсан; systemd-д энд заавал хоосон байлга.)
NEXT_PUBLIC_AUTH_APP_ID=
