{
  "name": "selbe",
  "version": "2.0.0",
  "private": true,
  "description": "Сэлбэ — Орон зайн хяналтын систем (GIS × IoT дашбоард)",
  "scripts": {
    "dev": "next dev -p 8123",
    "build": "next build",
    "start": "next start",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "node src/lib/filters.check.mjs && node src/lib/series.check.mjs && node src/lib/blockProgress.check.mjs && node src/modules/bagts.check.mjs && node src/modules/monitor.check.mjs && node src/modules/sheet/floor.check.mjs && node src/modules/analysis/suit/traffic.check.mjs && npm run test:agent && npm run test:drift && npm run test:tg && npm run test:chart",
    "test:agent": "node --experimental-transform-types --import ./tools/ts-alias.mjs src/lib/agent/agent.check.mjs",
    "test:drift": "node --experimental-transform-types --import ./tools/ts-alias.mjs src/lib/agent/drift.check.mjs",
    "ask": "node --experimental-transform-types --import ./tools/ts-alias.mjs tools/live-ask.mjs",
    "bot": "node --env-file-if-exists=.env.local --experimental-transform-types --import ./tools/ts-alias.mjs tools/telegram-bot.mjs",
    "test:tg": "node tools/telegram-format.check.mjs",
    "test:chart": "node --experimental-transform-types --import ./tools/ts-alias.mjs src/components/chart.check.mjs"
  },
  "dependencies": {
    "@arcgis/core": "^4.34.8",
    "next": "^15.5.21",
    "pdfmake": "^0.3.11",
    "react": "19.0.0",
    "react-dom": "19.0.0"
  },
  "devDependencies": {
    "@types/node": "22.10.7",
    "@types/pdfmake": "^0.3.3",
    "@types/react": "19.0.7",
    "@types/react-dom": "19.0.3",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.0",
    "typescript": "5.7.3"
  }
}
