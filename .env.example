# Сэлбэ портал — үйлчилгээний хаягуудын ЗАГВАР (зөвхөн нэрс).
# Энэ файлыг `.env` болгож хуулаад утгуудыг бөглөнө. `.env` нь git-д ОРОХГҮЙ.
#
# ⚠️ 2026-09-25: код дотор FALLBACK БАЙХГҮЙ — аль нэг мөр хоосон бол dev/build/тест
#    `services.ts req()`-ээр ил алдаа шиднэ. Deploy-д ижил нэрээр GitHub Variables.
# ⚠️ NEXT_PUBLIC_* нь build үед клиент код руу шингэдэг — НУУЦ БИШ. Токен, нууц
#    түлхүүрийг ЭНД ХЭЗЭЭ Ч бичихгүй (`.env.development.local` / релений `.env.local`).

# ── ArcGIS Online нэвтрэлт (OAuth 2.0 PKCE) ──
NEXT_PUBLIC_AUTH_APP_ID=
NEXT_PUBLIC_PORTAL_URL=
NEXT_PUBLIC_ALLOWED_ORG_ID=
# Нэвтрэлтийг САНААТАЙ унтраах бол (зөвхөн UI бүтэц харах):
# NEXT_PUBLIC_AUTH_OFF=1

# ── ArcGIS FeatureServer суурь (`…/arcgis/rest/services`) ──
NEXT_PUBLIC_ARCGIS_HJ=
NEXT_PUBLIC_ARCGIS_GAZAR=
NEXT_PUBLIC_ARCGIS_IOT=

# ── UBHUB ортофото · 3D · өндөр · BIM · зам ──
NEXT_PUBLIC_UBHUB_IMAGERY=
NEXT_PUBLIC_UBHUB_SCENE=
NEXT_PUBLIC_ELEVATION_URL=
NEXT_PUBLIC_BIM_ROOT=
NEXT_PUBLIC_ROAD_TILE_URL=

# ── AI туслахын реле (agent-proxy) — зөвхөн хаяг ──
NEXT_PUBLIC_AGENT_API=

# ── ХАБЭА Survey123 үйлчилгээний нэрс ──
NEXT_PUBLIC_HABEA_LABOR_SVC=
NEXT_PUBLIC_HABEA_INCIDENT_SVC=
NEXT_PUBLIC_HABEA_UZLEG_V11_SVC=
NEXT_PUBLIC_HABEA_UZLEG_G_SVC=
NEXT_PUBLIC_HABEA_UZLEG_ZAHIALAGCH_SVC=
