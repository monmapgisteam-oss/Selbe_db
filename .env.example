# Сэлбэ портал — үйлчилгээний хаягуудын ЗАГВАР (зөвхөн нэрс).
# Энэ файлыг `.env` болгож хуулаад утгуудыг бөглөнө. `.env` нь git-д ОРОХГҮЙ.
#
# ⚠️ 2026-09-25: код дотор FALLBACK БАЙХГҮЙ — аль нэг мөр хоосон бол dev/build/тест
#    `services.ts req()`-ээр ил алдаа шиднэ. Deploy-д ижил нэрээр GitHub Variables.
# ⚠️ NEXT_PUBLIC_* нь build үед клиент код руу шингэдэг — НУУЦ БИШ. Токен, нууц
#    түлхүүрийг ЭНД ХЭЗЭЭ Ч бичихгүй (`.env.development.local` / релений `.env.local`).

# ── ArcGIS Online нэвтрэлт (OAuth 2.0 PKCE) ──
NEXT_PUBLIC_AUTH_APP_ID=
NEXT_PUBLIC_PORTAL_URL=
NEXT_PUBLIC_ALLOWED_ORG_ID=
# Нэвтрэлтийг САНААТАЙ унтраах бол (зөвхөн UI бүтэц харах):
# NEXT_PUBLIC_AUTH_OFF=1
# Enterprise геопорталд PDF-ийг item болгон хадгалах ТУРШИЛТ («ТЭЗҮ» цонх; хоосон бол нуугдана):
# NEXT_PUBLIC_ENT_PORTAL_URL=https://gis.selbecity.mn/geoportal
# Чанар · MA (материал баталгаажуулалт) Survey123 — Enterprise hosted feature service, ТУРШИЛТ («MA» харагдац):
# NEXT_PUBLIC_CHANAR_MA_SVC=https://gis.selbecity.mn/map/rest/services/Hosted/<service_id>/FeatureServer
# Чанар · MIR (материалын үзлэг) Survey123 — Enterprise hosted (`/0` form · `/1` photos), ТУРШИЛТ:
# NEXT_PUBLIC_CHANAR_MIR_SVC=https://gis.selbecity.mn/map/rest/services/Hosted/<service_id>/FeatureServer

# ── ArcGIS FeatureServer суурь (`…/arcgis/rest/services`) ──
NEXT_PUBLIC_ARCGIS_HJ=
NEXT_PUBLIC_ARCGIS_GAZAR=
NEXT_PUBLIC_ARCGIS_IOT=

# ── UBHUB 3D · ортофото (Selbe_September_tif) · өндөр · зам ──
NEXT_PUBLIC_UBHUB_SCENE=
NEXT_PUBLIC_ELEVATION_URL=
# ⚠️ 2026-09-25: NEXT_PUBLIC_BIM_ROOT ХАСАГДСАН — BIM давхарга бүрмөсөн хасагдсан (services.ts).
NEXT_PUBLIC_ROAD_TILE_URL=
# Бүтээн байгуулалтын ӨМНӨХ ортофото («Иргэдэд хүрэх үр өгөөж») — `…/ImageServer` хүртэлх БҮТЭН хаяг.
# СОНГОЛТТОЙ: хоосон бол давхарга ба товч гарахгүй.
NEXT_PUBLIC_IRGED_ORTHO_PRE=

# ── Удирдлагын тайлангийн и-мэйл хүлээн авагчид (`emailReport.ts`) ──
# Таслалаар: a@selbecity.mn,b@selbecity.mn. Хоосон бол «Тайлан» илгээх товч хаалттай.
NEXT_PUBLIC_REPORT_RECIPIENTS=

# ── AI туслахын реле (agent-proxy) — зөвхөн хаяг ──
# Хэд хэдэн реле (үндсэн + нөөц хост) бол ТАСЛАЛААР: эхнийх давуу, унтарсан хостыг browser алгасна.
NEXT_PUBLIC_AGENT_API=
# ⚠️ 2026-10-09: релейн `PROMPT_HMAC`-тай ИЖИЛ утга — СОНГОЛТТОЙ (хоосон бол гарын үсэггүй).
# JS багцад ИЛ бичигдэнэ — хил биш, саад (`agent-proxy/README.md`). Deploy-д `AGENT_PROMPT_HMAC` Variable.
NEXT_PUBLIC_AGENT_PROMPT_HMAC=

# ── ХАБЭА Survey123 үйлчилгээний нэрс ──
NEXT_PUBLIC_HABEA_LABOR_SVC=
NEXT_PUBLIC_HABEA_INCIDENT_SVC=
NEXT_PUBLIC_HABEA_UZLEG_V11_SVC=
NEXT_PUBLIC_HABEA_UZLEG_G_SVC=
NEXT_PUBLIC_HABEA_UZLEG_ZAHIALAGCH_SVC=
