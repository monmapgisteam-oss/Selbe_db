# ═══════════════════════════════════════════════════════════════════
# СЭЛБЭ ПОРТАЛ — Үйлчилгээний хаягуудын НЭГДСЭН тохиргоо
# ═══════════════════════════════════════════════════════════════════
# Бүх ArcGIS/UBHUB үйлчилгээ ЭНД тодорхойлсон суурь хаягуудаас гардаг.
# Дэд үйлчилгээ (ET, GAZAR, IMAGERY, SCENE, BIM г.м.) нь эдгээрээс автоматаар
# бүтдэг тул зөвхөн ЭНД солиход хангалттай.
#
# ⚠️ NEXT_PUBLIC_* нь build үед клиент код руу шингэдэг (статик export) — нууц БИШ,
#    зөвхөн нийтийн үйлчилгээний хаяг. Client secret энд ХЭЗЭЭ Ч бичихгүй.
# ⚠️ Аль нэг мөрийг устгавал/хоосон орхивол код доторх FALLBACK (ижил утга)
#    ажиллана — гол ажиллагаа эвдрэхгүй.
# ═══════════════════════════════════════════════════════════════════ 

# ── ArcGIS Online нэвтрэлт (OAuth 2.0 PKCE) ──
# appId-г ХООСОН орхивол нэвтрэлт УНТРААЛТТАЙ (нэвтрэлтгүй ажиллана).
# ⚠️ 2026-08-21: хөгжүүлэлтийн явцад түр унтраасныг ЭРГҮҮЛЭН АСААВ.
#    Унтраахдаа энэ мөрийг хоосон орхино (NEXT_PUBLIC_AUTH_APP_ID=).
NEXT_PUBLIC_AUTH_APP_ID=ZPJRqk1iiYcjYRLv
NEXT_PUBLIC_PORTAL_URL=https://www.arcgis.com
NEXT_PUBLIC_ALLOWED_ORG_ID=HJzgwvlNIXssnQar

# ── Үндсэн байгууллагын FeatureServer суурь (ET, барилга, survey, санхүү г.м.) ──
NEXT_PUBLIC_ARCGIS_HJ=https://services.arcgis.com/HJzgwvlNIXssnQar/arcgis/rest/services

# ── Газар чөлөөлөлтийн тусдаа org (selbe_B, Selbe_parcel, хил) ──
NEXT_PUBLIC_ARCGIS_GAZAR=https://services-ap1.arcgis.com/ACqsMOmNLi5wIdIh/arcgis/rest/services

# ── UBHUB ортофото зураг (нэгтгэсэн selbe_ortho_merged ImageServer) ──
# ⚠️ 2026-08-06: хуучин mapservice.ubhub.mn унасан (404 Service not found).
#    Нэгтгэсэн үйлчилгээ шинэ host imagery.ubhub.mn дээр.
NEXT_PUBLIC_UBHUB_IMAGERY=https://imagery.ubhub.mn/imagery/rest/services/Hosted

# ── UBHUB 3D бодит загвар (SceneServer) ──
NEXT_PUBLIC_UBHUB_SCENE=https://arcgis.ubhub.mn/arcgis/rest/services/Hosted

# ── Esri дэлхийн өндрийн гадаргуу (3D terrain) ──
NEXT_PUBLIC_ELEVATION_URL=https://elevation3d.arcgis.com/arcgis/rest/services/WorldElevation3D/Terrain3D/ImageServer

# ── BIM tile суурь (71_1…71_12 SceneServer) ──
NEXT_PUBLIC_BIM_ROOT=https://tiles.arcgis.com/tiles/HJzgwvlNIXssnQar/arcgis/rest/services

# ── AI туслахын реле (agent-proxy) ──
# ⚠️ Энэ бол ЗӨВХӨН хаяг — LLM-ийн түлхүүр ЭНД ХЭЗЭЭ Ч бичигдэхгүй.
#    Түлхүүр нь зөвхөн релений процесст (ANTHROPIC_API_KEY) байна.
# ⚠️ Портал статик тул сервер тал ажиллахгүй — реле нь ТУСДАА процесс
#    (`agent-proxy/`). Локал хөгжүүлэлтэд localhost:8787.
NEXT_PUBLIC_AGENT_API=http://localhost:8787
